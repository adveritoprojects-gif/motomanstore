# ─── Database ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/motomanstore"

# ─── Site / SEO ──────────────────────────────────────────
# Canonical production origin (set this in Vercel — no trailing slash).
# Leave unset only for local development (falls back to https://motoman.in).
NEXT_PUBLIC_APP_URL="https://motoman.in"

# Google Search Console site verification token.
# Get it from Search Console → Settings → Ownership verification →
# "HTML tag" method → content="..." value. Do NOT commit a fake value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Optional brand override (used on the About page)
NEXT_PUBLIC_BRAND="MOTOMAN"

# ─── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# ─── Payments (Razorpay) ─────────────────────────────────
# Storefront "Pay Online" only appears when BOTH the server keys and the
# public key id are set. Use Test Mode keys (rzp_test_...) first — the public
# key is deliberately not derived from the secret so a live key never
# switches the storefront on by accident.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret from Razorpay Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=""

# ─── Email (Resend) ──────────────────────────────────────
# API key from https://resend.com/api-keys — server-side only, never exposed
# to the browser. Email failures are retried via the outbox and never block
# checkout or payment processing.
RESEND_API_KEY=""
# Must be a VERIFIED sender in Resend (Domains → verify motoman.in, then use
# e.g. orders@motoman.in). No hardcoded fallback — unset = emails disabled.
FROM_EMAIL=""
# Alerts address for new-order / payment emails. Unset = admin alerts skipped.
ADMIN_NOTIFICATION_EMAIL=""
# Bearer token protecting /api/cron/notifications (Vercel Cron sends it
# automatically when set). Generate with: openssl rand -hex 32
CRON_SECRET=""

# ─── Analytics (optional) ────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ─── Vercel Blob (admin product image uploads) ────────────
# Auto-injected on Vercel. Locally, run `vercel link` (project linked) so the
# server can authenticate with VERCEL_OIDC_TOKEN + BLOB_STORE_ID, or pull env
# values with `vercel env pull .env.local`. NEVER expose BLOB_READ_WRITE_TOKEN
# to the browser — it is only read by the server (/api/admin/uploads).
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""
# Webhook public key for the presigned upload flow (created with the store).
BLOB_WEBHOOK_PUBLIC_KEY=""
# Optional: max size per uploaded product image in bytes (default 8 MB).
PRODUCT_IMAGE_MAX_BYTES=""

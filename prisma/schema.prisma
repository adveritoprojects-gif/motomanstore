generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         String   @default("customer") // customer | admin
  phone        String?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Catalogue ──────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  sku            String         @unique
  /// Global Trade Item Number (GTIN/UPC/EAN). Optional — only set when the
  /// manufacturer provides one. Never invent GTINs.
  gtin           String?
  /// Manufacturer Part Number. Optional — only set when known.
  mpn            String?
  description    String
  price          Float
  compareAtPrice Float?
  /// SEO — optional per-product overrides. When empty the storefront falls
  /// back to the generated title/description derived from name/description.
  metaTitle       String?
  metaDescription String?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id])
  collectionId   String?
  collection     Collection?    @relation(fields: [collectionId], references: [id])
  inStock        Boolean        @default(true)
  featured       Boolean        @default(false)
  isNew          Boolean        @default(false)
  weight         Float?
  brand          String?
  tags           String[]
  images         ProductImage[]
  variants       ProductVariant[]
  orderItems     OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([slug])
  @@index([sku])
  @@index([categoryId])
  @@index([collectionId])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String  // e.g. "500ml", "1L", "Red"
  sku       String  @unique
  price     Float?
  stock     Int     @default(0)
  size      String?
  color     String?

  @@index([productId])
  @@index([sku])
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

// ─── Orders ─────────────────────────────────────────────

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  status          String       @default("pending") // pending | paid | processing | shipped | delivered | cancelled | refunded
  subtotal        Float
  shippingCost    Float        @default(0)
  /// Flat Cash-on-Delivery handling charge (₹20). Always 0 for online payments.
  codFee          Float        @default(0)
  total           Float
  shippingAddress Json
  customerEmail   String
  customerName    String
  customerPhone   String?
  razorpayOrderId   String?
  /// Client checkout attempt. Unique so two simultaneous submits reuse one order.
  checkoutAttemptId String?   @unique
  /// True while variant stock is deducted for this order.
  inventoryHeld     Boolean   @default(false)
  notes             String?
  emailNotifications EmailNotification[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([customerEmail])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int
  image     String
  variantId String?

  @@index([orderId])
}

// ─── Payments ───────────────────────────────────────────

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id])
  razorpayPaymentId String?  @unique
  razorpayOrderId   String?
  razorpaySignature String?
  amount            Float
  currency          String   @default("INR")
  status            String   @default("pending") // pending | success | failed | refunded
  method            String?  // upi, card, netbanking, wallet
  metadata          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([razorpayPaymentId])
  @@index([status])
}

// ─── Email notifications (transactional outbox) ─────────

/// Durable outbox for transactional emails. Rows are created by trusted
/// server-side events only; the unique eventKey is the idempotency guard
/// against webhook retries and repeated status updates.
model EmailNotification {
  id            String    @id @default(cuid())
  /// Logical event identity, e.g. "ORDER_PLACED:<orderId>:customer".
  eventKey      String    @unique
  eventType     String    // ORDER_PLACED | PAYMENT_SUCCEEDED | PAYMENT_FAILED | ORDER_SHIPPED | ORDER_DELIVERED | ORDER_CANCELLED | REFUND_PROCESSED
  orderId       String?
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Destination address (customer email or configured admin address).
  recipient     String
  /// "customer" | "admin" — never a client-supplied value.
  recipientRole String
  subject       String
  status        String    @default("pending") // pending | processing | sent | failed
  attempts      Int       @default(0)
  /// Safe, truncated error summary — never credentials or full payloads.
  lastError     String?
  /// Earliest time a delivery attempt may run (backoff). Null = terminal
  /// failure; only an explicit admin retry requeues it.
  nextRetryAt   DateTime?
  /// Set while a worker holds the row; stale locks are reclaimable.
  lockedAt      DateTime?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([orderId])
}
